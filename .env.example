# Reference only: the application reads exported environment variables, not this file.
OPEN_TRANSLATE_BASE_URL=http://127.0.0.1:1234/v1
OPEN_TRANSLATE_MODEL=YOUR_MODEL
# Leave the upstream key unset for a local endpoint that needs no authentication.
OPEN_TRANSLATE_API_KEY=
# Generate a long random value and keep it stable for your extension URL.
OPEN_TRANSLATE_TOKEN=REPLACE_WITH_A_PRIVATE_RANDOM_TOKEN
